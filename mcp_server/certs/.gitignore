# certs/
# 自签证书与私钥（server.crt / server.key），仅本机使用，不入库。
# 重新生成（openssl，SAN 含 127.0.0.1 与 localhost）：
#   openssl req -x509 -newkey rsa:2048 -keyout server.key -out server.crt \
#     -days 3650 -nodes -subj "/CN=claude-mcp-bridge" \
#     -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
*
!.gitignore
